# EZ Trade - admin environment (public VITE_* only, no secrets)
# Copy to .env and fill in the values. Keys marked (required) must be set.

## all keys this app reads
# backend API base URL (required)
VITE_API_URL=https://api.eztrade.io
# Supabase project URL (required)
VITE_SUPABASE_URL=
# Supabase anon (public) key (required)
VITE_SUPABASE_ANON_KEY=
VITE_COMPLIANCE_GRACE_MINUTES=
# member app URL (admin 'view as' opens here)
VITE_PLATFORM_URL=
VITE_SESSION_MAX_AGE_HOURS=
# optional static asset CDN origin
VITE_STATIC_ASSET_CDN_URL=
